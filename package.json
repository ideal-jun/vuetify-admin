{
  "name": "vuetify-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "oxlint . && eslint .",
    "lint:oxc": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix . && oxfmt .",
    "format": "oxfmt . && eslint --fix . && oxfmt .",
    "format:check": "oxfmt --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@mdi/font": "7.4.47",
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "defu": "^6.1.7",
    "nprogress": "^0.2.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@unocss/preset-wind4": "^66.11.0",
    "@unocss/transformer-directives": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vuetify/mcp": "^0.12.2",
    "eslint": "^10.13.0",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-check-file": "^3.3.2",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass-embedded": "^1.105.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "unocss-preset-vuetify": "^0.4.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,vue}": [
      "oxfmt --write",
      "eslint --fix"
    ],
    "*.{json,jsonc,md,scss,css,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.28.5"
}
