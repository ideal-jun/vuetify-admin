VITE_APP_TITLE=Vuetify Admin
VITE_APP_DESC=A fresh and elegant admin template built with Vue 3, Vuetify and UnoCSS.
VITE_BASE_URL=/
# history | hash | memory
VITE_ROUTER_HISTORY_MODE=history
# static | dynamic
VITE_AUTH_ROUTE_MODE=dynamic
VITE_ROUTE_HOME=home
VITE_STATIC_SUPER_ROLE=admin
VITE_SERVICE_BASE_URL=/api
# RuoYi-Cloud response codes
VITE_SERVICE_SUCCESS_CODE=200
VITE_SERVICE_LOGOUT_CODES=401
VITE_SERVICE_MODAL_LOGOUT_CODES=
VITE_HTTP_PROXY=Y
VITE_PROXY_TARGET=http://127.0.0.1:8888
VITE_STORAGE_PREFIX=vuetify-admin_
VITE_MENU_ICON=mdi-menu
VITE_ICON_PREFIX=icon
VITE_ICON_LOCAL_PREFIX=icon-local
VITE_SOURCE_MAP=N
VITE_AUTOMATICALLY_DETECT_UPDATE=N
VITE_DEFAULT_USER_PASSWORD=admin123